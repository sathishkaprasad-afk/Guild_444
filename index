    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        orbitron: ['Orbitron', 'sans-serif'],
                        rajdhani: ['Rajdhani', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            gold: '#FFD700',
                            amber: '#F59E0B',
                            red: '#EF4444',
                            darkBg: '#09090B'
                        }
                    }
                }
            }
        }
