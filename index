    <!-- ==================== JAVASCRIPT LOGIC ==================== -->
    <script>
        // Data State Management
        let logoClickCount = 0;
        let logoClickTimer = null;

        const defaultImages = {
            logo: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%2318181b'/><path d='M20 80 L50 20 L80 80 Z' fill='none' stroke='%23f59e0b' stroke-width='8'/><text x='50' y='68' font-size='32' font-family='sans-serif' font-weight='900' fill='%23f59e0b' text-anchor='middle'>444</text></svg>",
            leader: "https://i.postimg.cc/sXS7Pdhn/6633013e-fa5c-47ee-a464-5376887e7253.jpg",
            actingLeader: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%2318181b'/><circle cx='50' cy='35' r='20' fill='%23ef4444'/><path d='M20 90 C20 65 35 55 50 55 C65 55 80 65 80 90 Z' fill='%23ef4444'/><text x='50' y='38' font-size='12' font-weight='bold' fill='%23fff' text-anchor='middle'>S4G</text></svg>"
        };

        function loadSavedObject(key, fallback) {
            try {
                const raw = localStorage.getItem(key);
                if (!raw) return fallback;
                const parsed = JSON.parse(raw);
                return typeof parsed === 'object' && parsed !== null ? parsed : fallback;
            } catch (error) {
                console.warn(`Could not load saved data for ${key}; using defaults.`, error);
                return fallback;
            }
        }

        function loadSavedArray(key, fallback) {
            try {
                const raw = localStorage.getItem(key);
                if (!raw) return fallback;
                const parsed = JSON.parse(raw);
                return Array.isArray(parsed) ? parsed : fallback;
            } catch (error) {
                console.warn(`Could not load saved data for ${key}; using defaults.`, error);
                return fallback;
            }
        }

        let customImages = loadSavedObject('444_custom_images', { ...defaultImages });

        let registrations = loadSavedArray('444_registrations', [
            { id: 1, teamName: "ALPHA SQUAD", leaderName: "ROYAL", leaderUid: "238491023", whatsapp: "0771234567", slot: 1, time: "20:15" },
            { id: 2, teamName: "VIPER ESPORTS", leaderName: "VENOM", leaderUid: "883019284", whatsapp: "0719876543", slot: 2, time: "20:18" }
        ]);

        let leaderboardData = loadSavedArray('444_leaderboard', [
            { id: 1, rank: 1, squadName: "444 VANGUARD", leaderIgn: "444 • SHADOW", points: 2850 },
            { id: 2, rank: 2, squadName: "DARK SYNDICATE", leaderIgn: "DS • REAPER", points: 2420 },
            { id: 3, rank: 3, squadName: "BLOODline", leaderIgn: "BLD • KAISER", points: 2180 },
            { id: 4, rank: 4, squadName: "PHANTOM KINGS", leaderIgn: "PK • GHOST", points: 1950 }
        ]);

        // Save data helpers
        function saveData() {
            try {
                localStorage.setItem('444_custom_images', JSON.stringify(customImages));
                localStorage.setItem('444_registrations', JSON.stringify(registrations));
                localStorage.setItem('444_leaderboard', JSON.stringify(leaderboardData));
            } catch (error) {
                console.warn('Could not save data in this browser.', error);
                showCustomNotice('Storage Unavailable', 'Your browser could not save these changes.');
            }
            updateUI();
        }

        // Initialize UI
        function updateUI() {
            // Update Dynamic Images
            const logoImg = document.getElementById('displayLogoImg');
            if (logoImg) logoImg.src = customImages.logo || defaultImages.logo;

            const leaderImg = document.getElementById('displayLeaderImg');
            if (leaderImg) leaderImg.src = customImages.leader || defaultImages.leader;

            const actingLeaderImg = document.getElementById('displayActingLeaderImg');
            if (actingLeaderImg) actingLeaderImg.src = customImages.actingLeader || defaultImages.actingLeader;

            // Sync Admin Form Inputs
            const adminLogo = document.getElementById('adminLogoUrl');
            if (adminLogo) adminLogo.value = customImages.logo || '';

            const adminLeader = document.getElementById('adminLeaderUrl');
            if (adminLeader) adminLeader.value = customImages.leader || '';

            const adminActingLeader = document.getElementById('adminActingLeaderUrl');
            if (adminActingLeader) adminActingLeader.value = customImages.actingLeader || '';

            // Update Slots Count
            const slotsText = document.getElementById('slotsCountText');
            if (slotsText) {
                slotsText.innerText = `${registrations.length} / 12 Squads`;
            }

            // Update Unread Badge
            const badge = document.getElementById('unreadBadge');
            if (badge) {
                if (registrations.length > 0) {
                    badge.innerText = registrations.length;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            // Render Public Leaderboard
            const lbTbody = document.getElementById('leaderboardTbody');
            if (lbTbody) {
                const sortedLb = [...leaderboardData].sort((a,b) => b.points - a.points);
                lbTbody.innerHTML = sortedLb.map((item, idx) => `
                    <tr class="hover:bg-zinc-800/30 transition-colors">
                        <td class="p-4 font-extrabold text-amber-400">#${idx + 1}</td>
                        <td class="p-4 text-white">${escapeHtml(item.squadName)}</td>
                        <td class="p-4 text-gray-300">${escapeHtml(item.leaderIgn)}</td>
                        <td class="p-4 text-right font-bold text-amber-400">${item.points.toLocaleString()}</td>
                    </tr>
                `).join('');
            }

            // Render Standard Public Inbox
            const inboxList = document.getElementById('inboxList');
            if (inboxList) {
                if (registrations.length === 0) {
                    inboxList.innerHTML = `<div class="text-center py-8 text-gray-500 text-xs"><i class="fas fa-box-open text-3xl mb-2 block"></i>No registrations submitted yet.</div>`;
                } else {
                    inboxList.innerHTML = registrations.map(r => `
                        <div class="bg-zinc-950 border border-zinc-800 p-3.5 rounded-xl text-xs space-y-1 relative">
                            <div class="flex items-center justify-between font-bold text-amber-400">
                                <span>SLOT #${String(r.slot).padStart(2, '0')} - ${escapeHtml(r.teamName)}</span>
                                <span class="text-[10px] text-gray-500">${r.time}</span>
                            </div>
                            <div class="text-gray-300">Leader: <span class="text-white">${escapeHtml(r.leaderName)}</span> | UID: <span class="text-white">${escapeHtml(r.leaderUid)}</span></div>
                            <div class="text-emerald-400">WhatsApp: ${escapeHtml(r.whatsapp)}</div>
                        </div>
                    `).join('');
                }
            }

            // Render Admin Dashboard Inbox
            const adminInboxList = document.getElementById('adminInboxList');
            if (adminInboxList) {
                if (registrations.length === 0) {
                    adminInboxList.innerHTML = `<div class="text-center py-4 text-gray-500 text-xs">No registrations found.</div>`;
                } else {
                    adminInboxList.innerHTML = registrations.map(r => `
                        <div class="bg-zinc-950 border border-zinc-800 p-3 rounded-xl text-xs flex items-center justify-between">
                            <div>
                                <span class="font-bold text-amber-400">SLOT #${String(r.slot).padStart(2, '0')}</span> - 
                                <span class="font-bold text-white">${escapeHtml(r.teamName)}</span> 
                                <span class="text-gray-400">(${escapeHtml(r.leaderName)} / ${escapeHtml(r.whatsapp)})</span>
                            </div>
                            <button onclick="deleteRegistration(${r.id})" class="text-red-500 hover:text-red-400 p-1.5 hover:bg-red-500/10 rounded-lg transition-colors" title="Delete Entry">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    `).join('');
                }
            }

            // Render Admin Leaderboard Control List
            const adminLeaderboardList = document.getElementById('adminLeaderboardList');
            if (adminLeaderboardList) {
                adminLeaderboardList.innerHTML = leaderboardData.map((item, idx) => `
                    <div class="bg-zinc-950 border border-zinc-800 p-2.5 rounded-xl text-xs flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-bold text-amber-400">#${idx + 1}</span>
                            <span class="text-white font-semibold">${escapeHtml(item.squadName)}</span>
                            <span class="text-gray-400">(${item.points} pts)</span>
                        </div>
                        <button onclick="deleteLeaderboardEntry(${item.id})" class="text-red-500 hover:text-red-400 p-1">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `).join('');
            }
        }

        // Custom Images Save Action
        function saveCustomImages(e) {
            e.preventDefault();
            const logoVal = document.getElementById('adminLogoUrl').value.trim();
            const leaderVal = document.getElementById('adminLeaderUrl').value.trim();
            const actingLeaderVal = document.getElementById('adminActingLeaderUrl').value.trim();

            customImages = {
                logo: logoVal || defaultImages.logo,
                leader: leaderVal || defaultImages.leader,
                actingLeader: actingLeaderVal || defaultImages.actingLeader
            };

            saveData();
            showCustomNotice('Success', 'Images updated successfully!');
        }

        function resetImagesToDefault() {
            customImages = { ...defaultImages };
            saveData();
            showCustomNotice('Reset', 'Images restored to default settings.');
        }

        // 3-Tap Logo Secret Trigger for Admin Server Login
        function handleLogoClick() {
            logoClickCount++;
            clearTimeout(logoClickTimer);
            if (logoClickCount >= 3) {
                logoClickCount = 0;
                promptAdminAuth();
            } else {
                logoClickTimer = setTimeout(() => { logoClickCount = 0; }, 1000);
            }
        }

        // Admin Password Prompt
        function promptAdminAuth() {
            const authModal = document.getElementById('adminAuthModal');
            if (authModal) {
                authModal.classList.remove('hidden');
                setTimeout(() => {
                    const passInput = document.getElementById('adminPasswordInput');
                    if (passInput) passInput.focus();
                }, 100);
            }
        }

        function openAdminServerFromMenu() {
            toggleMobileMenu();
            setTimeout(() => {
                promptAdminAuth();
            }, 150);
        }

        function closeAdminAuthModal() {
            document.getElementById('adminAuthModal').classList.add('hidden');
            document.getElementById('adminPasswordInput').value = '';
        }

        function verifyAdminPassword(e) {
            e.preventDefault();
            const pass = document.getElementById('adminPasswordInput').value;
            if (pass === 'S4G_444') {
                closeAdminAuthModal();
                openAdminDashboard();
            } else {
                showCustomNotice('Access Denied', 'Incorrect Master Password!');
            }
        }

        function openAdminDashboard() {
            document.getElementById('adminDashboardModal').classList.remove('hidden');
        }

        function closeAdminDashboard() {
            document.getElementById('adminDashboardModal').classList.add('hidden');
        }

        // Registration Submission
        function handleRegistration(e) {
            e.preventDefault();
            if (registrations.length >= 12) {
                showCustomNotice('Match Full', 'Match slots are currently full (12/12)!');
                return;
            }

            const allocatedSlot = registrations.length + 1;
            const now = new Date();
            const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            const newReg = {
                id: Date.now(),
                teamName: document.getElementById('regTeamName').value,
                leaderName: document.getElementById('regLeaderName').value,
                leaderUid: document.getElementById('regLeaderUid').value,
                whatsapp: document.getElementById('regWhatsapp').value,
                slot: allocatedSlot,
                time: timeStr
            };

            registrations.push(newReg);
            saveData();

            closeRegisterModal();
            document.getElementById('regForm').reset();

            // Display Allocated Slot
            document.getElementById('allocatedSlotBadge').innerText = `SLOT #${String(allocatedSlot).padStart(2, '0')}`;
            document.getElementById('slotSuccessModal').classList.remove('hidden');
        }

        // Delete Individual Registration (Admin Server Only)
        function deleteRegistration(id) {
            registrations = registrations.filter(r => r.id !== id);
            registrations.forEach((r, idx) => r.slot = idx + 1);
            saveData();
        }

        // Clear All Mails / Submissions
        function clearAllMails() {
            if (registrations.length === 0) return;
            registrations = [];
            saveData();
        }

        // Add Leaderboard Entry
        function addLeaderboardEntry(e) {
            e.preventDefault();
            const newEntry = {
                id: Date.now(),
                rank: leaderboardData.length + 1,
                squadName: document.getElementById('addSquadName').value,
                leaderIgn: document.getElementById('addLeaderIgn').value,
                points: Math.max(0, parseInt(document.getElementById('addPoints').value, 10) || 0)
            };
            leaderboardData.push(newEntry);
            saveData();
            document.getElementById('addSquadName').value = '';
            document.getElementById('addLeaderIgn').value = '';
            document.getElementById('addPoints').value = '';
        }

        function deleteLeaderboardEntry(id) {
            leaderboardData = leaderboardData.filter(i => i.id !== id);
            saveData();
        }

        // Modal Controls
        function showTournamentNotice() {
            document.getElementById('noticeModal').classList.remove('hidden');
        }
        function closeTournamentNotice() {
            document.getElementById('noticeModal').classList.add('hidden');
        }

        function showCustomNotice(title, msg) {
            alert(`${title}: ${msg}`);
        }

        function scrollToNightBattles() {
            const el = document.getElementById('night-battles');
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function openRegisterModal() {
            document.getElementById('registerModal').classList.remove('hidden');
        }
        function closeRegisterModal() {
            document.getElementById('registerModal').classList.add('hidden');
        }

        function closeSlotSuccessModal() {
            document.getElementById('slotSuccessModal').classList.add('hidden');
        }

        function openPaidBattleModal() {
            document.getElementById('paidBattleModal').classList.remove('hidden');
        }
        function closePaidBattleModal() {
            document.getElementById('paidBattleModal').classList.add('hidden');
        }

        function openInboxModal() {
            const modal = document.getElementById('inboxModal');
            if (modal) {
                modal.classList.remove('hidden');
            }
        }
        function closeInboxModal() {
            const modal = document.getElementById('inboxModal');
            if (modal) {
                modal.classList.add('hidden');
            }
        }

        function toggleMobileMenu() {
            const drawer = document.getElementById('mobileDrawer');
            if (drawer) {
                drawer.classList.toggle('hidden');
            }
        }

        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, function(m) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
            });
        }

        // Close open modals when clicking outside modal box
        window.onclick = function(event) {
            const modals = [
                'noticeModal', 'registerModal', 'slotSuccessModal', 
                'paidBattleModal', 'inboxModal', 'adminAuthModal', 'adminDashboardModal'
            ];
            modals.forEach(modalId => {
                const el = document.getElementById(modalId);
                if (el && event.target === el) {
                    el.classList.add('hidden');
                }
            });
        };

        // Keyboard navigation (Escape key to close modals)
        window.onkeydown = function(event) {
            if (event.key === 'Escape') {
                const modals = [
                    'noticeModal', 'registerModal', 'slotSuccessModal', 
                    'paidBattleModal', 'inboxModal', 'adminAuthModal', 'adminDashboardModal'
                ];
                modals.forEach(modalId => {
                    const el = document.getElementById(modalId);
                    if (el && !el.classList.contains('hidden')) {
                        el.classList.add('hidden');
                    }
                });
            }
        };

        // Run initial UI state
        window.onload = function() {
            updateUI();
        };
    </script>
</body>
</html>
